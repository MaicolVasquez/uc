{
    "outputDirectory": "fronend",
    "functions": {
        "api/index.js": {
            "includeFiles": "backend/**"
        }
    },
    "redirects": [
        {
            "source": "/",
            "destination": "/home.html",
            "permanent": false
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        }
    ]
}